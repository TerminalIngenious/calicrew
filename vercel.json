{
  "crons": [
    { "path": "/api/cron?job=daily-challenge", "schedule": "0 15 * * *" },
    { "path": "/api/cron?job=creatine", "schedule": "0 18 * * *" },
    { "path": "/api/cron?job=hasard&h=9", "schedule": "0 9 * * *" },
    { "path": "/api/cron?job=hasard&h=11", "schedule": "0 11 * * *" },
    { "path": "/api/cron?job=hasard&h=13", "schedule": "0 13 * * *" },
    { "path": "/api/cron?job=hasard&h=15", "schedule": "0 15 * * *" },
    { "path": "/api/cron?job=ambiance&h=18", "schedule": "0 18 * * *" },
    { "path": "/api/cron?job=ambiance&h=19", "schedule": "0 19 * * *" },
    { "path": "/api/cron?job=ambiance&h=20", "schedule": "0 20 * * *" },
    { "path": "/api/cron?job=faceid", "schedule": "0 9 * * *" },
    { "path": "/api/cron?job=pas", "schedule": "0 20 * * *" },
    { "path": "/api/cron?job=recap", "schedule": "0 8 1 * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
